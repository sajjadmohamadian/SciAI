# Ollama runs locally and does not require an API key. Install Ollama, then run:
#   ollama pull qwen2.5:7b-instruct
#   ollama serve   # only if Ollama is not already running
# The model requires sufficient local memory; use SCIAI_OLLAMA_MODEL to choose another installed model.
# Only plain HTTP loopback URLs are accepted (localhost, 127.0.0.1, or [::1]).
SCIAI_OLLAMA_ENABLED="true"
SCIAI_OLLAMA_URL="http://127.0.0.1:11434"
SCIAI_OLLAMA_MODEL="qwen2.5:7b-instruct"
SCIAI_OLLAMA_TIMEOUT_MS="300000"

# Optional server-side cloud keys for explicit cloud selection or fallback.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# AI provider routing. Cloud fallback sends the prompt to the selected cloud provider.
# Keep cloud keys unset or turn fallback off if data must remain local.
# Keys and local configuration are server-only; never expose them via VITE_* variables.
SCIAI_AI_DEFAULT_PROVIDER="ollama"
SCIAI_AI_PROVIDER_ORDER="ollama,gemini,claude,openai"
SCIAI_AI_ALLOW_FALLBACK="true"
SCIAI_AI_TIMEOUT_MS="30000"
SCIAI_AI_MAX_RETRIES="2"
SCIAI_AI_LOG_PROMPTS="false"
SCIAI_GEMINI_MODEL="gemini-flash-latest"
SCIAI_CLAUDE_MODEL="claude-opus-5"
SCIAI_OPENAI_MODEL="gpt-4.1-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST: Network interface to bind the Express server to.
# Defaults to "localhost" for local development safety.
HOST="localhost"

# PORT: Port to bind the server to (defaults to 3000).
PORT=3000

# SCIAI_API_TOKEN: Server-side API bearer token for protected mutations and AI operations.
# Required when HOST is non-localhost or when authentication is enabled.
SCIAI_API_TOKEN=""

# SCIAI_DEV_AUTH_BYPASS: Set to "true" to bypass API token requirement during local development on localhost.
SCIAI_DEV_AUTH_BYPASS="true"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins for external API access.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# SCIAI_PUBLIC_UPLOADS: Set to "true" only when hosted browser uploads should be open to everyone.
# This affects dataset upload only; other protected mutations still require SCIAI_API_TOKEN.
SCIAI_PUBLIC_UPLOADS="false"

# SCIAI_PUBLIC_ORIGIN: Exact hosted browser origin allowed to use public upload mode.
# Leave empty for local defaults, or set to your deployed site origin such as "https://example.com".
# Render users may also rely on RENDER_EXTERNAL_URL when Render provides it.
SCIAI_PUBLIC_ORIGIN=""
